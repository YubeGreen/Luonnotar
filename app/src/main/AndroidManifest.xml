<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="ch.protonvpn.android" />
        <package android:name="com.tailscale.ipn" />
        <package android:name="com.google.android.gms" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".LuonnotarApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_luonnotar"
        android:label="努昂诺塔"
        android:roundIcon="@mipmap/ic_luonnotar"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProtonKeeper">

        <meta-data
            android:name="com.yubegreen.developer.NAME"
            android:value="@string/developer_name" />

        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".ActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.ProtonKeeper.Transparent" />

        <activity
            android:name=".policy.PolicyActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.FcmGuardianService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":keeper">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains a user-enabled VPN-dependent push connectivity watchdog" />
        </service>


        <service
            android:name=".privileged.embedded.EmbeddedAdbService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-invoked local wireless ADB pairing and startup for the Luonnotar privileged engine" />
        </service>

        <receiver
            android:name=".privileged.embedded.EmbeddedGuardianSupervisorReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".privileged.embedded.EmbeddedGuardianBootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".notification.ArrivalNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".receiver.BootCompletedReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            android:process=":keeper">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.LabAlarmReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            android:process=":keeper" />

        <receiver
            android:name=".receiver.GuardianCleanupReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".receiver.ExactAlarmPermissionChangedReceiver"
            android:enabled="true"
            android:exported="false"
            android:process=":keeper">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.AdbEmbeddedEngineControlReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.yubegreen.luonnotar.action.ADB_ENGINE_RESTART" />
                <action android:name="com.yubegreen.luonnotar.action.ADB_ENGINE_STATUS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.AdbVpnVerificationReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":keeper">
            <intent-filter>
                <action android:name="com.yubegreen.luonnotar.action.ADB_VERIFY_VPN" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.AdbFreezerDiagnosticsReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":keeper">
            <intent-filter>
                <action android:name="com.yubegreen.luonnotar.action.ADB_IMPORT_FREEZER" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".receiver.AdbGmsBinderPulseReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":keeper">
            <intent-filter>
                <action android:name="com.yubegreen.luonnotar.action.ADB_GMS_BINDER_PULSE_TEST" />
                <action android:name="com.yubegreen.luonnotar.action.ADB_GMS_BINDER_STABILIZATION_LEASE" />
                <action android:name="com.yubegreen.luonnotar.action.ADB_GMS_IMPORTANCE_FENCE_STATUS" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".receiver.AdbRuntimeConfigReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":keeper">
            <intent-filter>
                <action android:name="com.yubegreen.luonnotar.action.ADB_RUNTIME_CONFIG_STATUS" />
                <action android:name="com.yubegreen.luonnotar.action.ADB_SET_RUNTIME_CONFIG" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".receiver.AdbNotificationDiagnosticsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.yubegreen.luonnotar.action.ADB_NOTIFICATION_STATUS" />
                <action android:name="com.yubegreen.luonnotar.action.ADB_NOTIFICATION_PRIVACY" />
                <action android:name="com.yubegreen.luonnotar.action.ADB_NOTIFICATION_SCAN_ACTIVE" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".service.AdbRuntimeConfigProvider"
            android:authorities="${applicationId}.adb_runtime_config"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":keeper" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".service.GuardianStatusProvider"
            android:authorities="${applicationId}.status"
            android:directBootAware="true"
            android:exported="false"
            android:process=":keeper" />

        <!-- r300: explicit-component, shell-only NotificationListener fault injection. -->
        <receiver
            android:name=".receiver.AdbNotificationListenerFaultReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
